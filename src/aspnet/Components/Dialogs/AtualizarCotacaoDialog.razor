@namespace Finort.Components.Dialogs
@inherits AppComponentBase

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Atualizar cotação</MudText></TitleContent>
    <DialogContent>
        <MudMoneyInput @bind-Value="_valor" CasasDecimais="2" Label="Nova cotação" Variant="@gVariant" />
        <MudDatePicker @bind-Date="_data" Label="Data" Variant="@gVariant" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="Salvar">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Investimento Investimento { get; set; } = default!;
    [Parameter] public EventCallback<(decimal? valor, DateTime? data)> OnSave { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private decimal? _valor;
    private DateTime? _data = DateTime.Today;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        await OnSave.InvokeAsync((_valor, _data));
        MudDialog.Close();
    }
}
