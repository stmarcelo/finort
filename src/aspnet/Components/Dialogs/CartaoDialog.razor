@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@inject CartaoCreditoService CartaoCreditoService
@inject ContaService ContaService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Cartao is null ? "Novo cartão" : "Editar cartão")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_banco" Label="Nome do cartão" Variant="@gVariant" Required="true"
                          RequiredError="Informe o nome do cartão." />
            <MudTextField T="string" @bind-Value="_ultimos4" Label="Últimos dígitos" Variant="@gVariant"
                          Required="true" RequiredError="Informe os dígitos."
                          Immediate="true"
                           Placeholder="7634, 6234"
                          HelperText="Pode ser adicionado os 4 digitos dos cartões virtuais"
                          Validation="@(new Func<string, string?>(ValidarDigitos))" />
            <MudNumericField T="int" @bind-Value="_melhorDia" Label="Melhor dia de compra" Variant="@gVariant"
                             Min="1" Max="31" Required="true" />
            <MudNumericField T="int" @bind-Value="_diaVencimento" Label="Dia de vencimento" Variant="@gVariant"
                             Min="1" Max="31" Required="true" />
            <MudMoneyInput @bind-Value="_limite" Label="Limite" Variant="@gVariant" Required="true" />
            <MudSelect T="Guid?" Label="Conta de pagamento" Variant="@gVariant" @bind-Value="_contaId"
                       Placeholder="Opcional" SearchBox="true" SearchBoxPlaceholder="Buscar...">
                @foreach (var conta in _contas)
                {
                    <MudSelectItem T="Guid?" Value="@conta.Id">@conta.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="Salvar">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public CartaoCredito? Cartao { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = null!;
    private string _banco = string.Empty;
    private string _ultimos4 = string.Empty;
    private int _melhorDia = 5;
    private int _diaVencimento = 10;
    private decimal? _limite;
    private Guid? _contaId;
    private List<Conta> _contas = new();

    protected override async Task OnInitializedAsync()
    {
        _contas = await ContaService.ListarAsync();
        if (Cartao is not null)
        {
            _banco = Cartao.Banco;
            _ultimos4 = Cartao.Ultimos4Digitos;
            _melhorDia = Cartao.MelhorDiaCompra;
            _diaVencimento = Cartao.DiaVencimento;
            _limite = Cartao.Limite;
            _contaId = Cartao.ContaId;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        var digitos = new string(_ultimos4.Where(char.IsAsciiDigit).ToArray());
        var digitosOk = digitos.Length >= 4 && digitos.Length % 4 == 0 && digitos.Length <= 20;
        if (!digitosOk || _limite is null or <= 0)
        {
            Snackbar.Add("Informe os 4 dígitos e um limite maior que zero.", Severity.Error);
            return;
        }

        try
        {
        Guid idSalvo;
        if (Cartao is null)
            idSalvo = (await CartaoCreditoService.CriarAsync(_banco.Trim(), digitos, _melhorDia, _diaVencimento, _limite.Value, _contaId)).Id;
        else
        {
            await CartaoCreditoService.AtualizarAsync(Cartao, _banco.Trim(), digitos, _melhorDia, _diaVencimento, _limite.Value, _contaId);
            idSalvo = Cartao.Id;
        }
        MudDialog.Close(DialogResult.Ok(idSalvo));
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string? ValidarDigitos(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (value.Any(c => !char.IsDigit(c) && c != ',' && c != ' '))
            return "Apenas números, vírgula e espaço";
        var grupos = value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        foreach (var grupo in grupos)
        {
            if (grupo.Length != 4 || !grupo.All(char.IsDigit))
                return "Cada grupo deve ter 4 dígitos (ex: 7634, 6234)";
        }
        if (grupos.Length > 5) return "Máximo 5 grupos";
        return null;
    }
}
