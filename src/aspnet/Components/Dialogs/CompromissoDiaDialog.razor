@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@using System.Globalization
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Titulo</MudText></TitleContent>
    <DialogContent>
        @if (Itens.Count == 0)
        {
            <MudText Typo="Typo.body2">Nenhum compromisso neste dia.</MudText>
        }
        else
        {
            @foreach (var grupo in AgruparItens(Itens))
            {
                <div class="d-flex justify-space-between align-center py-2 px-3 mb-1 cal-dia-item @(grupo.IsLembrete ? "cal-item-lembrete" : "") @(grupo.IsFatura ? "cal-item-fatura" : "")">
                    <div>
                        <div class="d-flex align-center gap-2">
                            @if (grupo.IsLembrete || grupo.IsFatura)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" />
                            }
                            <span class="cal-valor @(grupo.Tipo == LancamentoTipo.Despesa ? "neg" : "pos") @(grupo.Confirmado ? "cal-ok" : "")">
                                @grupo.ValorTotal.ToString("N2")
                            </span>
                            @if (grupo.Projetada)
                            {
                                <span class="cal-proj">Projeção</span>
                            }
                            else if (grupo.Confirmado)
                            {
                                <span class="cal-badge">Confirmado</span>
                            }
                            @if (grupo.Quantidade > 1)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                    @grupo.Quantidade lançamentos
                                </MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.body2">@grupo.Pessoa</MudText>
                    </div>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Fechar">Fechar</MudButton>
        <MudButton Color="Color.Primary" OnClick="VerLancamentosDoMes">Ver lançamentos do mês</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly CultureInfo CulturaPtBr = new("pt-BR");

    [Parameter] public DateOnly Data { get; set; }
    [Parameter] public IReadOnlyList<CompromissoItem> Itens { get; set; } = Array.Empty<CompromissoItem>();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string Titulo => char.ToUpper(Data.ToString("dddd, dd 'de' MMMM 'de' yyyy", CulturaPtBr)[0])
        + Data.ToString("dddd, dd 'de' MMMM 'de' yyyy", CulturaPtBr)[1..];

    private void Fechar() => MudDialog.Close();

    private void VerLancamentosDoMes()
    {
        MudDialog.Close();
        Navigation.NavigateTo($"/lancamentos?mes={Data.Month}&ano={Data.Year}");
    }

    private static IReadOnlyList<CompromissoAgrupado> AgruparItens(IReadOnlyList<CompromissoItem> itens)
    {
        return itens
            .GroupBy(i => new { i.Tipo, Pessoa = i.PessoaNome ?? (i.IsLembrete || i.IsFatura ? i.Descricao : "Sem Pessoa"), i.IsLembrete, i.IsFatura })
            .Select(g => new CompromissoAgrupado(
                g.Key.Pessoa,
                g.Key.Tipo,
                g.Sum(i => i.Valor),
                g.Count(),
                g.All(i => i.Confirmado),
                g.Any(i => i.Projetada),
                g.Key.IsLembrete,
                g.Key.IsFatura,
                g.All(i => i.Riscada)))
            .OrderBy(g => g.IsFatura ? 0 : g.IsLembrete ? 1 : 2)
            .ThenBy(g => g.Tipo)
            .ThenBy(g => g.Pessoa)
            .ToList();
    }
}
