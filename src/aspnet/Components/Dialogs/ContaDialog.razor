@namespace Finort.Components.Dialogs
@inject ContaService ContaService

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Conta is null ? "Nova conta" : "Editar conta")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_nome" Label="Nome da conta" Variant="@GlobalVariant.Value" Required="true"
                          RequiredError="Informe um nome." />
            <MudTextField @bind-Value="_banco" Label="Código do banco" Variant="@GlobalVariant.Value" />
            <MudTextField @bind-Value="_agencia" Label="Agência" Variant="@GlobalVariant.Value" />
            <MudTextField @bind-Value="_contaEDigito" Label="Conta e dígito" Variant="@GlobalVariant.Value"
                          Immediate="true" Placeholder="1234-5"
                          Validation="@(new Func<string, string?>(ValidarContaDigito))" />
            <MudMoneyInput @bind-Value="_limite" Label="Limite" Variant="@GlobalVariant.Value" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@GlobalVariant.Value" OnClick="Salvar">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Conta? Conta { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = null!;
    private string _nome = string.Empty;
    private string? _banco;
    private string? _agencia;
    private string? _contaEDigito;
    private decimal? _limite;

    protected override void OnInitialized()
    {
        if (Conta is not null)
        {
            _nome = Conta.Nome;
            _banco = Conta.Banco;
            _agencia = Conta.Agencia;
            _contaEDigito = Conta.ContaEDigito;
            _limite = Conta.Limite;
        }
    }

    private static string? ValidarContaDigito(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (!System.Text.RegularExpressions.Regex.IsMatch(value, @"^\d+-\d$"))
            return "Digite apenas números com um hífen e um dígito final (ex: 1231233-4).";

        return null;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        Guid idSalvo;
        if (Conta is null)
            idSalvo = (await ContaService.CriarAsync(_nome.Trim(), StringVazioParaNull(_banco), StringVazioParaNull(_agencia), StringVazioParaNull(_contaEDigito), _limite)).Id;
        else
        {
            await ContaService.AtualizarAsync(Conta, _nome.Trim(), StringVazioParaNull(_banco), StringVazioParaNull(_agencia), StringVazioParaNull(_contaEDigito), _limite);
            idSalvo = Conta.Id;
        }

        MudDialog.Close(DialogResult.Ok(idSalvo));
    }

    private static string? StringVazioParaNull(string? s)
        => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}