@namespace Finort.Components.Dialogs
@inherits AppComponentBase

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Fechar fatura com reembolsos</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Há reembolsos pendentes nesta fatura. Escolha conta e categoria únicas para gerar 1 receita por pessoa.</MudText>
        <ContaSelect Label="Conta da receita" Placeholder="Selecione" Required="true"
                     RequiredError="Informe a conta." @bind-Value="_contaId" />
        <CategoriaSelect Label="Categoria da receita" Placeholder="Selecione" Required="true"
                         RequiredError="Informe a categoria." @bind-Value="_categoriaId" />
        <SubcategoriaSelect Label="Subcategoria" CategoriaId="_categoriaId" @bind-Value="_subcategoriaId" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="Confirmar" Disabled="@(_contaId is null || _categoriaId is null)">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record FechamentoReembolsoEscolha(Guid ContaId, Guid CategoriaId, Guid? SubcategoriaId);

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private Guid? _contaId;
    private Guid? _categoriaId;
    private Guid? _subcategoriaId;

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar()
    {
        if (_contaId is null || _categoriaId is null) return;
        MudDialog.Close(DialogResult.Ok(new FechamentoReembolsoEscolha(_contaId.Value, _categoriaId.Value, _subcategoriaId)));
    }
}
