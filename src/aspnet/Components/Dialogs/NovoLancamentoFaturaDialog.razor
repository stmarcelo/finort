@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@using Finort.Components.Lancamentos
@inject LancamentoService LancamentoService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Novo lançamento na fatura</MudText></TitleContent>
    <DialogContent>
        <DespesaCartaoForm @ref="_form" CartaoIdFixo="@CartaoId" AnoFatura="@Ano" MesFatura="@Mes" OnSalvarValido="Salvar" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="SalvarClick">Adicionar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid CartaoId { get; set; }
    [Parameter] public int Ano { get; set; }
    [Parameter] public int Mes { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private DespesaCartaoForm _form = null!;
    private bool _salvando;

    private void Cancelar() => MudDialog.Cancel();

    private Task SalvarClick() => _form.ValidarESalvarAsync();

    private async Task Salvar(DespesaCartaoForm.DadosDespesaCartao d)
    {
        if (_salvando) return;
        _salvando = true;
        try
        {
            await LancamentoService.CriarDespesaCartaoAsync(
                CartaoId, d.Data, d.Valor, d.CategoriaId, d.SubcategoriaId, d.PessoaId,
                parcelas: null, reembolsoPessoaId: null, reembolsoVencimento: null,
                vencimentoExato: d.DataVencimentoCartao, reembolsoContaId: null, ehEntrada: d.EhEntrada,
                projetoId: d.ProjetoId);
            Snackbar.Add("Lançamento adicionado à fatura.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _salvando = false; }
    }
}
