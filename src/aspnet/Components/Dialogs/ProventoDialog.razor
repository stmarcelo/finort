@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Titulo</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudDatePicker @bind-Date="_data" Label="Data" Variant="@gVariant" Required="true" />
            <MudMoneyInput @bind-Value="_valor" CasasDecimais="@CasasDecimais"
                           Label="Valor" Variant="@gVariant" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="Registrar">Registrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ProventoTipo Tipo { get; set; }
    [Parameter] public int CasasDecimais { get; set; } = 2;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = null!;
    private DateTime? _data = DateTime.Today;
    private decimal? _valor;

    private string Titulo => Tipo == ProventoTipo.Dividendo ? "Dividendos" : "Rendimento";

    private void Cancelar() => MudDialog.Cancel();

    private async Task Registrar()
    {
        await _form.Validate();
        if (!_form.IsValid || _valor is null or <= 0 || _data is null) return;

        MudDialog.Close(DialogResult.Ok(
            (DateOnly.FromDateTime(_data.Value), _valor.Value)));
    }
}
