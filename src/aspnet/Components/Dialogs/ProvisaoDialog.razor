@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@inject ProvisaoService ProvisaoService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Provisao is null ? "Nova provisão" : "Editar provisão")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSelect T="ProvisaoOnde" Label="Onde" Variant="@gVariant" Value="@_onde"
                       ValueChanged="OnOndeChanged" Required="true">
                <MudSelectItem Value="ProvisaoOnde.DebitoConta">Débito em conta</MudSelectItem>
                <MudSelectItem Value="ProvisaoOnde.DebitoCartao">Débito em cartão</MudSelectItem>
                <MudSelectItem Value="ProvisaoOnde.Receita">Receita</MudSelectItem>
            </MudSelect>

            @if (_onde == ProvisaoOnde.DebitoCartao)
            {
                <CartaoSelect Required="true" RequiredError="Selecione o cartão."
                              @bind-Value="_cartaoId" />
            }
            else
            {
                <ContaSelect Label="@( _onde == ProvisaoOnde.Receita ? "Conta de crédito" : "Conta de débito" )"
                             Required="true" RequiredError="Selecione a conta."
                             @bind-Value="_contaId" />
            }

            <MudSelect T="ProvisaoFrequencia" Label="Frequência" Variant="@gVariant" @bind-Value="_frequencia"
                       Required="true">
                <MudSelectItem Value="ProvisaoFrequencia.Mensal">Mensal</MudSelectItem>
                <MudSelectItem Value="ProvisaoFrequencia.Trimestral">Trimestral</MudSelectItem>
                <MudSelectItem Value="ProvisaoFrequencia.Semestral">Semestral</MudSelectItem>
                <MudSelectItem Value="ProvisaoFrequencia.Anual">Anual</MudSelectItem>
            </MudSelect>

            <MudNumericField T="int" @bind-Value="_dia" Label="Dia do mês" Variant="@gVariant" Min="1" Max="31"
                             Required="true" />
            <MudMoneyInput Label="Valor" Variant="@gVariant" @bind-Value="_valor" Required="true" />
            <MudCheckBox T="bool" Value="@_valorVariante" ValueChanged="(bool v) => _valorVariante = v"
                         Label="Valor variante (alterações no lançamento não alteram a provisão)" />

            <CategoriaSelect Required="true" RequiredError="Selecione a categoria."
                             Value="@_categoriaId" ValueChanged="OnCategoriaChanged" />
            <SubcategoriaSelect CategoriaId="@_categoriaId" @bind-Value="_subcategoriaId" />
            <PessoaSelect Placeholder="Opcional" @bind-Value="_pessoaId" />

            @if (Provisao is null)
            {
                <MudCheckBox @bind-Value="_lancarAgora" Label="Lançar no mês corrente agora" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="@gVariant" OnClick="Salvar">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Provisao? Provisao { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = null!;

    private ProvisaoOnde _onde = ProvisaoOnde.DebitoConta;
    private ProvisaoFrequencia _frequencia = ProvisaoFrequencia.Mensal;
    private Guid? _contaId;
    private Guid? _cartaoId;
    private int _dia = 1;
    private decimal? _valor;
    private bool _valorVariante;
    private Guid? _categoriaId;
    private Guid? _subcategoriaId;
    private Guid? _pessoaId;
    private bool _lancarAgora;

    protected override void OnInitialized()
    {
        if (Provisao is not null)
        {
            _onde = Provisao.Onde;
            _frequencia = Provisao.Frequencia;
            _dia = Provisao.Dia;
            _contaId = Provisao.ContaId;
            _cartaoId = Provisao.CartaoCreditoId;
            _valor = Provisao.Valor;
            _valorVariante = Provisao.ValorVariante;
            _categoriaId = Provisao.CategoriaId;
            _subcategoriaId = Provisao.SubcategoriaId;
            _pessoaId = Provisao.PessoaId;
        }
    }

    private void OnOndeChanged(ProvisaoOnde onde)
        => _onde = onde;

    private Task OnCategoriaChanged(Guid? categoriaId)
    {
        _categoriaId = categoriaId;
        return Task.CompletedTask;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        if (_valor is null or <= 0)
        {
            Snackbar.Add("Informe um valor maior que zero.", Severity.Error);
            return;
        }

        var destinoOk = _onde == ProvisaoOnde.DebitoCartao ? _cartaoId.HasValue : _contaId.HasValue;
        if (!destinoOk)
        {
            Snackbar.Add("Informe o destino da provisão.", Severity.Error);
            return;
        }
        if (_categoriaId is null)
        {
            Snackbar.Add("Selecione a categoria.", Severity.Error);
            return;
        }

        try
        {
            if (Provisao is null)
            {
                var nova = new Provisao
                {
                    Onde = _onde,
                    Frequencia = _frequencia,
                    Dia = _dia,
                    PessoaId = _pessoaId,
                    ContaId = _onde == ProvisaoOnde.DebitoCartao ? null : _contaId,
                    CartaoCreditoId = _onde == ProvisaoOnde.DebitoCartao ? _cartaoId : null,
                    Valor = _valor.Value,
                    ValorVariante = _valorVariante,
                    CategoriaId = _categoriaId.Value,
                    SubcategoriaId = _subcategoriaId
                };
                await ProvisaoService.CriarAsync(nova, lancarMesCorrente: _lancarAgora);
            }
            else
            {
                var dados = new Provisao
                {
                    Onde = _onde,
                    Frequencia = _frequencia,
                    Dia = _dia,
                    PessoaId = _pessoaId,
                    ContaId = _onde == ProvisaoOnde.DebitoCartao ? null : _contaId,
                    CartaoCreditoId = _onde == ProvisaoOnde.DebitoCartao ? _cartaoId : null,
                    Valor = _valor.Value,
                    ValorVariante = _valorVariante,
                    CategoriaId = _categoriaId.Value,
                    SubcategoriaId = _subcategoriaId
                };
                await ProvisaoService.AtualizarAsync(Provisao, dados);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
