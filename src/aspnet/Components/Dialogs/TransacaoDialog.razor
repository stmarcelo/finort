@namespace Finort.Components.Dialogs
@inherits AppComponentBase
@using Finort.Components.Lancamentos
@using Finort.Models.Financeiro
@inject LancamentoService LancamentoService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@_titulo</MudText>
    </TitleContent>
    <DialogContent>
        @if (_tipo == LancamentoTipo.Despesa && TipoTransacao == "cartao")
        {
            <DespesaCartaoForm @ref="_cartaoForm" LancamentoId="@LancamentoId" OnSalvarValido="SalvarCartaoAsync" />
        }
        else
        {
            <LancamentoForm Tipo="@_tipo" LancamentoId="@_lancamentoGuidId" OnSaved="FecharAsync" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        @if (_tipo == LancamentoTipo.Despesa && TipoTransacao == "cartao")
        {
            <MudButton Color="Color.Primary" Variant="@gVariant"
                       OnClick="@(async () => await _cartaoForm!.ValidarESalvarAsync())">Salvar</MudButton>
        }
    </DialogActions>
</MudDialog>

<script>
    window.finortFocusFirstField = function () {
        var el = document.querySelector('.mud-select input, .mud-autocomplete input, input:not([type=hidden])');
        if (el) el.focus();
    };
</script>

@code {
    [Parameter] public string TipoTransacao { get; set; } = "receita";
    [Parameter] public Guid? LancamentoId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private LancamentoTipo _tipo;
    private Guid? _lancamentoGuidId;
    private DespesaCartaoForm? _cartaoForm;

    private string _titulo => TipoTransacao switch
    {
        "receita" => LancamentoId.HasValue ? "Editar receita" : "Nova receita",
        "despesa" => LancamentoId.HasValue ? "Editar despesa" : "Nova despesa",
        "cartao" => LancamentoId.HasValue ? "Editar despesa de cartão" : "Nova despesa de cartão",
        "transferencia" => LancamentoId.HasValue ? "Editar transferência" : "Nova transferência",
        _ => "Novo lançamento"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || LancamentoId.HasValue) return;
        await Task.Delay(150);
        try
        {
            await JS.InvokeVoidAsync("finortFocusFirstField");
        }
        catch { /* Server prerendering — ignore */ }
    }

    protected override void OnInitialized()
    {
        _tipo = TipoTransacao switch
        {
            "receita" => LancamentoTipo.Receita,
            "despesa" => LancamentoTipo.Despesa,
            "cartao" => LancamentoTipo.Despesa,
            "transferencia" => LancamentoTipo.Transferencia,
            _ => LancamentoTipo.Despesa
        };
        _lancamentoGuidId = LancamentoId;
    }

    private void Cancelar() => MudDialog.Cancel();

    private Task FecharAsync()
    {
        MudDialog.Close(DialogResult.Ok(true));
        return Task.CompletedTask;
    }

    private async Task SalvarCartaoAsync(DespesaCartaoForm.DadosDespesaCartao d)
    {
        try
        {
            bool atualizarFuturos = false;
            if (LancamentoId.HasValue)
            {
                var lancamento = await LancamentoService.ObterAsync(LancamentoId.Value);
                if (lancamento?.ParcelamentoId.HasValue == true && lancamento.ParcelaAtual == 1)
                {
                    var temFuturos = await LancamentoService.TemLancamentosFuturosNoGrupoAsync(
                        LancamentoId.Value, lancamento.ParcelamentoId.Value);

                    // Check if any installment or reimbursement is confirmed
                    var temConfirmados = await LancamentoService.TemLancamentosConfirmadosNoGrupoAsync(
                        LancamentoId.Value, lancamento.ParcelamentoId.Value);

                    if (temConfirmados)
                    {
                        await DialogService.ShowMessageBox(
                            "Não é possível propagar alterações",
                            "Existem parcelas ou reembolsos confirmados. A alteração será aplicada apenas a este lançamento.",
                            "OK");
                    }
                    else if (temFuturos)
                    {
                        var confirm = await DialogService.ShowMessageBox(
                            "Alterar parcelas futuras",
                            "Deseja aplicar as alterações também nas parcelas futuras não confirmadas?",
                            "Sim", "Não", "Cancelar",
                            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
                        if (confirm is null) return;
                        atualizarFuturos = confirm == true;
                    }
                }

                await LancamentoService.AtualizarDespesaCartaoAsync(
                    LancamentoId.Value, d.CartaoId, d.Data, d.Valor, d.CategoriaId, d.SubcategoriaId,
                    d.PessoaId, d.Parcelas, d.ReembolsoPessoaId,
                    vencimentoExato: d.DataVencimentoCartao,
                    ehEntrada: d.EhEntrada, projetoId: d.ProjetoId,
                    atualizarFuturos: atualizarFuturos);
                Snackbar.Add("Lançamento atualizado.", Severity.Success);
            }
            else
            {
                await LancamentoService.CriarDespesaCartaoAsync(
                    d.CartaoId, d.Data, d.Valor, d.CategoriaId, d.SubcategoriaId, d.PessoaId,
                    d.Parcelas, d.ReembolsoPessoaId,
                    vencimentoExato: d.DataVencimentoCartao,
                    ehEntrada: d.EhEntrada, projetoId: d.ProjetoId);
                Snackbar.Add("Lançamento salvo.", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
