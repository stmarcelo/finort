@namespace Finort.Components.Lancamentos
@using Finort.Components.Shared
@inherits AppComponentBase
@inject ContaService ContaService
@inject CategoriaService CategoriaService
@inject LancamentoService LancamentoService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudForm @ref="_form">
    @if (Tipo == LancamentoTipo.Transferencia)
    {
        <ContaSelect Label="Conta de origem" Required="true"
                     RequiredError="Selecione a conta de origem."
                     @bind-Value="_contaOrigemId" />
        <ContaSelect Label="Conta de destino" Required="true"
                     RequiredError="Selecione a conta de destino."
                     @bind-Value="_contaDestinoId" />
        <DataPicker Label="Data" Variant="@gVariant" @bind-Date="_data" Required="true" />
        <MudMoneyInput Label="Valor" Variant="@gVariant" @bind-Value="_valor" Required="true" />
    }
    else
    {
        <ContaSelect Label="Conta" Placeholder="Opcional"
                     Value="@_contaId" ValueChanged="OnContaChanged" />
        <DataPicker Label="Data" Variant="@gVariant" @bind-Date="_data" Required="true" />
        <MudMoneyInput Label="Valor" Variant="@gVariant" @bind-Value="_valor" Required="true" />
        <CategoriaSelect Required="true" RequiredError="Selecione a categoria."
                         Value="@_categoriaId" ValueChanged="OnCategoriaChanged" />
        <SubcategoriaSelect CategoriaId="@_categoriaId" @bind-Value="_subcategoriaId" />
        <PessoaSelect Placeholder="Opcional" @bind-Value="_pessoaId" />
        <ProjetoSelect PessoaId="@_pessoaId" @bind-Value="_projetoId" />
        <MudTextField T="string" @bind-Value="_observacao" Label="Observação"
                      Variant="@gVariant" Lines="2" MaxLength="500" />
        @if (LancamentoId is null)
        {
            <MudCheckBox @bind-Value="_confirmado" Label="Já confirmado" Class="mt-2"
                         Disabled="@(_contaId is null)" />
            @if (_contaId is null)
            {
                <MudText Typo="Typo.caption" Style="opacity:0.7;" Class="mb-2">
                    Selecione uma conta para marcar "Já confirmado".
                </MudText>
            }
        }
        @if (Tipo == LancamentoTipo.Despesa)
        {
            <MudCheckBox @bind-Value="_reembolso" Label="Terá reembolso" Class="mt-2" />
            @if (_reembolso)
            {
                <PessoaSelect Label="Pessoa do reembolso" Required="true"
                              RequiredError="Selecione a pessoa do reembolso."
                              @bind-Value="_reembolsoPessoaId" />
                <DataPicker Label="Data do reembolso" Variant="@gVariant" @bind-Date="_reembolsoData" Required="true" />
            }
        }
        <div class="d-flex align-center flex-wrap mt-2">
            @if (!_temGrupo)
            {
                <MudSwitch @bind-Value="_repetir" Label="Repetir" Class="flex-grow-0" />
                @if (_repetir)
                {
                    <MudNumericField T="int" @bind-Value="_quantidadeRepeticoes" Label="Vezes"
                                     Variant="@gVariant" Min="2" Max="120" Class="ml-4" Style="max-width:120px;" />
                }
            }
        </div>
    }
</MudForm>

<MudButton Variant="@gVariant" Color="Color.Primary" FullWidth="true" OnClick="Salvar"
           Disabled="@(_salvando)">@(_salvando ? "Salvando..." : "Salvar")</MudButton>
