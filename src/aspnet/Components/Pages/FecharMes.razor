@page "/fechar-mes"
@attribute [Authorize]
@inherits AppComponentBase
@using System.Globalization
@inject FechamentoService FechamentoService
@inject ContaService ContaService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Fechar mês</PageTitle>

<div class="d-flex align-center flex-wrap mb-2">
    <MudText Typo="Typo.h5" Class="d-inline-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="mr-2" /> Fechar mês
    </MudText>
    <span class="flex-grow-1"></span>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit"
                   OnClick="MesAnterior" />
    <MudText Class="mx-2">@RotuloMes</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Inherit"
                   OnClick="ProximoMes" />
</div>

@if (_conferencias is null)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" />
}
else
{
    @if (_ultimoMesFechado is not null && _ultimoMesFechado.Value.Ano == _ano && _ultimoMesFechado.Value.Mes == _mes)
    {
        <MudButton Variant="@gVariant" Color="Color.Warning" Class="mt-2 mb-2"
                   StartIcon="@Icons.Material.Filled.LockOpen" OnClick="ReabrirMes">
            Reabrir este mês (todas as contas)
        </MudButton>
    }

    <MudDataGrid T="ConferenciaMes" Items="@_conferencias" Hover="true" Striped="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.NomeConta" Title="Conta" />
            <TemplateColumn Title="Saldo acumulado">
                <CellTemplate>
                    <span class="@(context.Item.SaldoAcumulado >= 0 ? "pos" : "neg")">
                        @context.Item.SaldoAcumulado.ToString("N2")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Pendências">
                <CellTemplate>
                    @if (context.Item.TemPendencias)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pendente</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">OK</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    @if (context.Item.MesFechado)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Fechado</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Aberto</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Saldo real">
                <CellTemplate>
                    @if (!context.Item.MesFechado && !context.Item.TemPendencias)
                    {
                        <div class="d-flex align-center gap-0">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                           Color="@(_saldosNegativos[context.Item.ContaId] ? Color.Error : Color.Default)"
                                           Class="@(context.Item.MesFechado ? "" : "saldo-neg-btn")"
                                           OnClick="@(() => _saldosNegativos[context.Item.ContaId] = !_saldosNegativos.GetValueOrDefault(context.Item.ContaId))" />
                            <MudMoneyInput @bind-Value="_saldosReais[context.Item.ContaId]"
                                           Variant="@gVariant" Margin="Margin.Dense"
                                           Label="Saldo real" Style="max-width:150px"
                                           HelperText="Negativo? Clique no sinal"
                                           Class="@(_saldosNegativos[context.Item.ContaId] ? "saldo-negativo" : "")" />
                        </div>
                    }
                    else if (context.Item.MesFechado)
                    {
                        <span class="text-muted">—</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Ação">
                <CellTemplate>
                    @if (!context.Item.MesFechado && !context.Item.TemPendencias)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Disabled="@(!_saldosReais.ContainsKey(context.Item.ContaId) || _saldosReais[context.Item.ContaId] is null)"
                                   OnClick="@(() => FecharConta(context.Item.ContaId))">
                            Fechar
                        </MudButton>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@code {
    private static readonly CultureInfo CulturaPtBr = new("pt-BR");
    private DateOnly Hoje => DateOnly.FromDateTime(DateTime.Today);

    private int _ano;
    private int _mes;
    private List<ConferenciaMes>? _conferencias;
    private Dictionary<Guid, decimal?> _saldosReais = new();
    private Dictionary<Guid, bool> _saldosNegativos = new();
    private (int Ano, int Mes)? _ultimoMesFechado;

    private string RotuloMes => new DateTime(_ano, _mes, 1).ToString("MMMM yyyy", CulturaPtBr);

    protected override async Task OnInitializedAsync()
    {
        _ano = Hoje.Year;
        _mes = Hoje.Month;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        try
        {
            _conferencias = await FechamentoService.ObterConferenciasAsync(_ano, _mes);
            _saldosReais = new Dictionary<Guid, decimal?>();
            _saldosNegativos = new Dictionary<Guid, bool>();
            foreach (var c in _conferencias)
            {
                _saldosReais[c.ContaId] = null;
                _saldosNegativos[c.ContaId] = false;
            }
            _ultimoMesFechado = await FechamentoService.ObterUltimoMesFechadoAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MesAnterior() => await Navegar(-1);
    private async Task ProximoMes() => await Navegar(1);

    private async Task Navegar(int delta)
    {
        var destino = new DateOnly(_ano, _mes, 1).AddMonths(delta);
        _ano = destino.Year;
        _mes = destino.Month;
        await CarregarAsync();
    }

    private async Task FecharConta(Guid contaId)
    {
        if (!_saldosReais.TryGetValue(contaId, out var saldoReal) || saldoReal is null) return;

        var conferencia = _conferencias?.FirstOrDefault(c => c.ContaId == contaId);
        if (conferencia is null) return;

        var saldoCalculado = _saldosNegativos[contaId] ? -Math.Abs(saldoReal.Value) : saldoReal.Value;
        var diferenca = saldoCalculado - conferencia.SaldoAcumulado;
        var textoAcerto = diferenca == 0
            ? "Sem diferença a lançar."
            : $"Será lançado um acerto de {diferenca:N2} na categoria \"Acerto de saldo\".";

        var conta = await ContaService.ObterAsync(contaId);
        var confirmar = await DialogService.ShowMessageBox(
            "Fechar mês",
            $"Conta: {conta?.Nome}\nSaldo real informado: {saldoCalculado:N2}\n{textoAcerto}\n\nO mês será bloqueado permanentemente para esta conta.",
            "Confirmar", null, "Cancelar",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (confirmar != true) return;

        try
        {
            await FechamentoService.FecharAsync(contaId, _ano, _mes, saldoCalculado);
            Snackbar.Add("Mês fechado com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await CarregarAsync();
    }

    private async Task ReabrirMes()
    {
        var confirmar = await DialogService.ShowMessageBox(
            "Reabrir mês",
            $"Tem certeza que deseja reabrir {_mes:D2}/{_ano}? Todas as contas fechadas neste mês serão reabertas.",
            "Reabrir", null, "Cancelar",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (confirmar != true) return;

        try
        {
            await FechamentoService.ReabrirAsync(_ano, _mes);
            Snackbar.Add("Mês reaberto com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await CarregarAsync();
    }
}
