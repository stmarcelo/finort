    private async Task<IEnumerable<string>> Buscar(string texto, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return _secoes.Select(s => s.Titulo);

        var termo = texto.Trim();
        return _secoes
            .Where(s => s.Titulo.Contains(termo, StringComparison.OrdinalIgnoreCase)
                        || s.Paragrafos.Any(p => p.Contains(termo, StringComparison.OrdinalIgnoreCase))
                        || s.Subsecoes.Any(sub => sub.Titulo.Contains(termo, StringComparison.OrdinalIgnoreCase)
                                                  || sub.Itens.Any(i => i.Contains(termo, StringComparison.OrdinalIgnoreCase))))
            .Select(s => s.Titulo);
    }

    private void NavegarPara(string titulo)
    {
        _textoBusca = string.Empty;
        if (string.IsNullOrWhiteSpace(titulo)) return;
        var secao = _secoes.FirstOrDefault(s => s.Titulo == titulo);
        if (secao is not null)
        {
            Navigation.NavigateTo($"/manual#{secao.Id}", forceLoad: true);
        }
    }

    private async Task IrParaTopo()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("manualScrollInterop.init", dotNetRef);
        }
    }

    [JSInvokable]
    public void OnScrollChanged(bool showButton)
    {
        _mostrarBotaoTopo = showButton;
        InvokeAsync(StateHasChanged);
    }
}
