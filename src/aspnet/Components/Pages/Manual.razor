@page "/manual"
@attribute [Authorize]
@inherits AppComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Manual</PageTitle>

<MudPaper Class="pa-4 mb-4 mt-4">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                <img src="/img/logo_finort.png" alt="Finort" class="manual-logo" />
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.h5">Manual do sistema</MudText>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudAutocomplete T="string" Label="Acesso rápido" @bind-Text="_textoBusca" Variant="@gVariant" Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" CoerceText="false"
                             SearchFunc="Buscar" MaxHeight="300" Style="max-width:350px;float:right"
                             ValueChanged="NavegarPara" ResetValueOnEmptyText="true" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudGrid Spacing="4">
    @foreach (var secao in _secoes)
    {
        <MudItem xs="12" Id="@secao.Id">
            <MudPaper Class="pa-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@secao.Icone" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@secao.Titulo</MudText>
                </MudStack>
                @foreach (var paragrafo in secao.Paragrafos)
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@paragrafo</MudText>
                }
                @if (secao.Subsecoes.Count > 0)
                {
                    @foreach (var sub in secao.Subsecoes)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@sub.Titulo</MudText>
                        @foreach (var item in sub.Itens)
                        {
                            <MudText Typo="Typo.body2" Class="ml-2 mb-1">• @item</MudText>
                        }
                    }
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@if (_mostrarBotaoTopo)
{
    <div style="position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 1100;">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                OnClick="IrParaTopo" />
    </div>
}

<script>
    window.manualScrollInterop = {
        init: function (dotNetRef) {
            window.addEventListener('scroll', function () {
                dotNetRef.invokeMethodAsync('OnScrollChanged', window.scrollY > 100);
            });
        }
    };
</script>

